# payzeno-contracts is owned by Platform, but the files that four repos inherit from
# are pinned to the CTO. Changing errors.ts or version.ts changes every service at once.
# Review policy: 1 approval (world default). Two if you touch src/events/**, because
# Core consumes it — ask nmigration.

*                                   @payzeno/platform @osquash

# --- CTO-pinned. Do not merge without dhotfix. ------------------------------
src/errors.ts                       @dhotfix
src/version.ts                      @dhotfix
src/internal/                       @dhotfix
src/codegen/ir.ts                   @dhotfix
src/codegen/emitters/emitter.ts     @dhotfix
docs/adr/                           @dhotfix

# --- Event schemas. Core owns the consumer side of every one of these. ------
src/events.ts                       @nmigration @dhotfix
src/events/                         @nmigration
src/test-support/                   @nmigration

# --- Type surface. Platform. -----------------------------------------------
src/types/                          @osquash
src/codegen/                        @osquash

# --- Generated trees. Regenerated, never hand-edited. Reviewed for drift only.
python/                             @osquash
java/                               @osquash @dhotfix

# --- Release plumbing ------------------------------------------------------
package.json                        @osquash @dhotfix
CHANGELOG.md                        @osquash @dhotfix
.github/                            @payzeno/platform
