{
  "name": "@payzeno/contracts",
  "version": "3.4.0",
  "description": "Shared request/response types, event envelopes and money helpers for every Payzeno service. Zero runtime dependencies.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.payzeno.internal/"
  },
  "repository": {
    "type": "git",
    "node": ">=20.11.0",
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@8.15.8",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "require": "./dist/events.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./guards": {
      "types": "./dist/guards.d.ts",
      "import": "./dist/guards.js",
      "require": "./dist/guards.cjs"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "import": "./dist/money.js",
      "require": "./dist/money.cjs"
    },
    "./ids": {
      "types": "./dist/ids.d.ts",
      "import": "./dist/ids.js",
      "require": "./dist/ids.cjs"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js",
      "require": "./dist/version.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md,cjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,cjs,ts}\"",
    "test:watch": "vitest",
    "codegen:java": "tsx src/codegen/cli.ts --target java --out java",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "20.12.7",
    "@typescript-eslint/eslint-plugin": "7.8.0",
    "@typescript-eslint/parser": "7.8.0",
    "@vitest/coverage-v8": "1.6.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.29.1",
    "tsup": "8.0.2",
    "tsx": "4.10.2",
    "vitest": "1.6.0"
  }
}
