{
  "name": "@payzeno/contracts",
  "version": "3.4.0",
  "description": "Shared request/response types, event envelopes and money helpers for every Payzeno service. Zero runtime dependencies.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.payzeno.internal/"
  },
  "repository": {
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@8.15.8",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "require": "./dist/events.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./guards": {
      "types": "./dist/guards.d.ts",
      "import": "./dist/guards.js",
      "require": "./dist/guards.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .tsbuildinfo",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,cjs,ts}\"",
    "@vitest/coverage-v8": "1.6.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.29.1",
    "vitest": "1.6.0"
  }
}
